{
  "name": "dsh-undo-redo",
  "version": "0.1.0",
  "private": true,
  "description": "Unsend and restore conversation progress: /undo, /redo, and a session-header control",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "react",
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-typert-protocol": "*"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-api-gateway": "*",
    "@deepseek-ai/dsh-session": "*",
    "@deepseek-ai/dsh-typert-registry": "*"
  }
}
